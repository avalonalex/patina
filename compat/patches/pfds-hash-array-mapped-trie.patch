     (define (mask key level)
-      (bitwise-arithmetic-shift-right (bitwise-and key (- (expt 2 5) 1)) level))
+      (bitwise-and (bitwise-arithmetic-shift-right key level) (- (expt 2 5) 1)))
 
     (define (level-up level)
       (+ level 5))
