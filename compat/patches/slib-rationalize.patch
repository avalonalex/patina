# Correctness overlay for #519, authorized by the #429 patch policy.
# https://github.com/avalonalex/patina/issues/519
# Return integer numerator/denominator components for a singleton interval.
# Both Patina backends, Chibi 0.12 and Gauche 0.9.15 reproduce the failures
# on the pinned body. The maintained smoke driver gates the corrected behavior.
# This driver passes 11/12 before repair and 12/12 afterward on all four.
# Comparisons isolate SLIB library names and pinned SRFI 63; a portable SRFI 60
# facade over native SRFI 151 supplies the missing dependency on Chibi.
--- a/slib/rationalize.sld
+++ b/slib/rationalize.sld
@@ -49,7 +49,7 @@
                              (list (+ (cadr rat) (* fx (car rat))) (car rat))))
                 (else (list (+ 1 fx) 1)))))
       (cond ((< y x) (find-ratio-between y x))
-            ((>= x y) (list x 1))
+            ((>= x y) (list (numerator x) (denominator x)))
             ((positive? x) (sr x y))
             ((negative? y) (let ((rat (sr (- y) (- x))))
                              (list (- (car rat)) (cadr rat))))
