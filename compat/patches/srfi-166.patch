-          (lp (string-cursor-next str sc2)
+          (lp (if (string-cursor>=? sc2 end) end (string-cursor-next str sc2))
               (if (string-cursor=? sc sc2)
                   res
                   (cons (substring/cursors str sc sc2) res)))))))))
@@ -320,8 +320,10 @@
