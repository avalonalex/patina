(import (scheme base) (prefix (slib time-core) t:) (rename (patina compat smoke) (check-equal smoke-check-equal)))
;; Calendar seconds may be exact or inexact depending on the clock adapter.
;; Compare their numerical values without imposing an exactness contract.
(define (numeric-data x)
  (cond ((number? x) (exact x))
        ((pair? x) (cons (numeric-data (car x)) (numeric-data (cdr x))))
        (else x)))
(define (check-equal label expected actual)
  (smoke-check-equal label (numeric-data expected) (numeric-data actual)))
(define-syntax observed
  (syntax-rules () ((_ expr) (guard (ex (else 'unexpected-error)) expr))))
(check-equal "GMT decodes 1970-01-01T00:00:00+00:00" '#(0 0 0 1 0 70 4 0 0 0 "GMT")
  (t:time:gmtime 0))
(check-equal "GMT decodes 1969-12-31T23:59:59+00:00" '#(59 59 23 31 11 69 3 364 0 0 "GMT")
  (t:time:gmtime -1))
(check-equal "GMT decodes 1968-12-31T00:00:00+00:00" '#(0 0 0 31 11 68 2 365 0 0 "GMT")
  (t:time:gmtime -31622400))
(check-equal "GMT decodes 1968-02-29T00:00:00+00:00" '#(0 0 0 29 1 68 4 59 0 0 "GMT")
  (t:time:gmtime -58060800))
(check-equal "GMT decodes 1900-03-01T00:00:00+00:00" '#(0 0 0 1 2 0 4 59 0 0 "GMT")
  (t:time:gmtime -2203891200))
(check-equal "GMT decodes 2000-02-29T00:00:00+00:00" '#(0 0 0 29 1 100 2 59 0 0 "GMT")
  (t:time:gmtime 951782400))
(check-equal "GMT decodes 2100-03-01T00:00:00+00:00" '#(0 0 0 1 2 200 1 59 0 0 "GMT")
  (t:time:gmtime 4107542400))
(check-equal "GMT decodes 2024-12-31T23:59:59+00:00" '#(59 59 23 31 11 124 2 365 0 0 "GMT")
  (t:time:gmtime 1735689599))
(check-equal "calendar round trips cover pre-epoch, leap and future years" '(0 -1 -31622400 951782400 4107542400)
  (map (lambda (t) (t:time:invert t:time:gmtime (t:time:gmtime t))) '(0 -1 -31622400 951782400 4107542400)))
(check-equal "Gregorian leap rules include century exceptions" '(#f #t #t #f #t #f)
  (map t:leap-year? '(1900 2000 2024 2100 2400 2023)))
(check-equal "difference and offset preserve fractional seconds" '(3/2 11/4 -3/2)
  (list (t:difftime 5/2 1) (t:offset-time 5/2 1/4) (t:difftime 1 5/2)))
(check-equal "west offsets cross the preceding day and retain metadata" '#(0 30 18 31 11 69 3 364 1 19800 "WEST")
  (t:time:split 0 1 19800 "WEST"))
(check-equal "east offsets advance local clock" '#(0 30 5 1 0 70 4 0 0 -19800 "EAST")
  (t:time:split 0 0 -19800 "EAST"))
(check-equal "fixed timezone parameters are independent of timestamp" '(0 -19800 "IST")
  (t:tz:params 1704067200 '#(tz:fixed "IST-5:30" "IST" -19800)))
(check-equal "month-week-day rules use the previous offset" 1710054000
  (t:tzrule->caltime 124 18000 3 2 0 7200))
(check-equal "week five means the last matching weekday" 1730008800
  (t:tzrule->caltime 124 14400 10 5 0 7200))
(check-equal "Julian day one is January first" 1704067200
  (t:tzrule->caltime 124 0 #f #f 1 0))
(check-equal "Julian rules omit leap day while ordinal rules include it" '(1709251200 1709251200 1709164800)
  (list (t:tzrule->caltime 124 0 #f #f 60 0)
        (t:tzrule->caltime 124 0 #f #t 60 0)
        (t:tzrule->caltime 124 0 #f #t 59 0)))
(check-equal "year-1900 rule arguments retain the 2000 century leap day" 951868800
  (t:tzrule->caltime 100 0 #f #f 60 0))
(check-equal "last-week rules honor century leap years using full Gregorian years" 951782400
  (t:tzrule->caltime 100 0 2 5 2 0))
(check-equal "northern DST starts inclusively and ends exclusively" '((0 18000 "EST") (1 14400 "EDT") (1 14400 "EDT") (0 18000 "EST"))
  (let ((zone '#(tz:rule "fixture" "EST" "EDT" 18000 14400 (3 2 0 7200) (11 1 0 7200))))
    (map (lambda (t) (t:tz:params t zone)) '(1710053999 1710054000 1730613599 1730613600))))
(check-equal "southern DST spans the turn of the year" '((1 -39600 "AEDT") (0 -36000 "AEST") (1 -39600 "AEDT"))
  (let ((zone '#(tz:rule "fixture" "AEST" "AEDT" -36000 -39600 (10 1 0 7200) (4 1 0 10800))))
    (map (lambda (t) (t:tz:params t zone)) '(1704067200 1719792000 1733011200))))
(define modes '#(#("STD" -18000 #f #f #f) #("DST" -14400 #t #f #f)))
(define zone (vector 'tz:file "fixture" modes '#() '#(10 20 30 40 50 60) '#(0 1 0 1 0 1)))
(check-equal "transition lookup covers every interval and exact boundary" '(-1 0 0 1 2 3 4 5 5)
  (map (lambda (t) (t:tzfile:transition-index t zone)) '(9 10 19 20 30 40 50 60 100)))
(check-equal "transition lookup handles singleton and empty tables" '(-1 0 -1)
  (list (t:tzfile:transition-index 9 (vector 'tz:file "" modes '#() '#(10) '#(1)))
        (t:tzfile:transition-index 10 (vector 'tz:file "" modes '#() '#(10) '#(1)))
        (t:tzfile:transition-index 10 (vector 'tz:file "" modes '#() '#() '#()))))
(check-equal "pre-transition time selects a standard record" '#("STD" -18000 #f #f #f)
  (t:tzfile:get-zone-spec 0 zone))
(check-equal "active transition selects its type and converts east offset to west" '(1 14400 "DST")
  (t:tz:params 20 zone))
(check-equal "standard-record search skips daylight records" '#("STD" -18000 #f #f #f)
  (t:tzfile:get-std-spec (vector (vector-ref modes 1) (vector-ref modes 0))))
(check-error "unknown timezone encodings are rejected" (t:tz:params 0 '#(unknown)))
(check-error "invalid transition weeks are rejected" (t:tzrule->caltime 124 0 3 6 0 0))
(check-equal "southern transitions preserve inclusive start and exclusive end"
  '((1 -39600 "AEDT") (0 -36000 "AEST") (0 -36000 "AEST") (1 -39600 "AEDT"))
  (let ((zone '#(tz:rule "fixture" "AEST" "AEDT" -36000 -39600 (10 1 0 7200) (4 1 0 10800))))
    (map (lambda (t) (t:tz:params t zone)) '(1712419199 1712419200 1728143999 1728144000))))
(check-equal "transition search handles both odd and even table lengths" #t
  (let lengths ((n 0))
    (if (= n 18) #t
      (let ((times (make-vector n)) (types (make-vector n 0)))
        (do ((i 0 (+ i 1))) ((= i n)) (vector-set! times i (* 10 (+ i 1))))
        (let ((zone (vector 'tz:file "fixture" modes '#() times types)))
          (let queries ((t 0))
            (if (> t (+ 10 (* 10 n))) (lengths (+ n 1))
              (and (= (t:tzfile:transition-index t zone)
                      (min (- n 1) (- (quotient t 10) 1)))
                   (queries (+ t 1))))))))))
(smoke-finish)
