(import (scheme base) (scheme cxr) (scheme write) (scheme eval) (scheme repl) (scheme lazy) (scheme case-lambda) (scheme process-context))
(define N (string->number (cadr (command-line))))
(define which (string->symbol (caddr (command-line))))
(define env (interaction-environment))
(define form
  (case which
    ((let-values) '(let-values (((a b) (values 1 2))) (+ a b)))
    ((guard) '(guard (e (#t 0)) (raise 'x)))
    ((parameterize) '(let ((p (make-parameter 1))) (parameterize ((p 2)) (p))))
    ((case-lambda) '((case-lambda ((x) x) ((x y) (+ x y))) 1 2))
    ((delay) '(force (delay (+ 1 2))))
    ((do) '(do ((i 0 (+ i 1))) ((= i 3) i)))
    ((case) '(case 3 ((1 2) 'a) ((3) 'b) (else 'c)))
    ((record) '(define-record-type point (make-point x y) point? (x point-x)))
    ((let) '(let loop ((i 0)) (if (< i 3) (loop (+ i 1)) i)))
    ((plain) '(+ 1 2))
    (else (error "unknown" which))))
(let loop ((i 0))
  (when (< i N)
    (eval form env)
    (loop (+ i 1))))
(display 'done) (newline)
