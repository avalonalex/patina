+/// Per-collection survival result produced by `Heap::demog_scan`.
+#[derive(Default)]
+pub struct Scan {
+    pub young_alloc: [u64; NCLASS],
+    pub young_alloc_bytes: [u64; NCLASS],
+    pub young_surv: [u64; NCLASS],
+    pub young_surv_bytes: [u64; NCLASS],
+    pub live: [u64; 4],
+    pub live_bytes: u64,
+    pub dead_old: u64,
+    pub dead_old_bytes: u64,
+    pub age: [u64; 8],
+    pub arena_len: [u64; 4],
+    pub free_slots: [u64; 4],
+}
+
+pub fn age_bucket(age: u32) -> usize {
+    match age {
+        0..=3 => age as usize,
+        4..=7 => 4,
+        8..=15 => 5,
+        16..=63 => 6,
+        _ => 7,
+    }
+}
+
+/// Direct access to the collection-number epochs and the current count.
+#[allow(clippy::mut_from_ref)]
+pub fn epochs_mut() -> (&'static mut [Vec<u32>; 4], u32) {
+    let s = st();
+    let c = s.gc_count;
+    (&mut s.gcno, c)
+}
+
+/// Epoch accessors for the scan (primary heap only).
+pub fn gc_count() -> u32 {
+    st().gc_count
+}
+pub fn slot_gcno(arena: usize, idx: usize) -> u32 {
+    st().gcno[arena].get(idx).copied().unwrap_or(FREE)
+}
+pub fn free_slot(arena: usize, idx: usize) {
+    let s = st();
+    if let Some(g) = s.gcno[arena].get_mut(idx) {
+        *g = FREE;
+    }
+}
+pub const FREE_EPOCH: u32 = FREE;
+
+/// Record one collection. `scan` is `None` in pause mode.
+pub fn on_collect(scan: Option<Scan>, mark_us: u64, sweep_us: u64, scan_us: u64) {
+    let m = mode();
+    if m == MODE_OFF {
