+                let _ = write!(w, ",ya_{c},ys_{c}");
+            }
+            for a in 0..8 {
+                let _ = write!(w, ",age{a}");
+            }
+            let _ = writeln!(w);
+            s.gclog = Some(w);
+        }
+    }
+    let gc = s.gc_count;
+    let alloc_seq = s.alloc_seq;
+    let (frames, regs) = (s.sp_frames, s.sp_regs);
+    if let Some(sc) = &scan {
+        let ya: u64 = sc.young_alloc.iter().sum();
+        s.marked_total_sum += sc.live.iter().sum::<u64>();
+        for k in [0usize, 1] {
+            if k == 1 && gc == 0 {
+                continue;
+            }
+            for c in 0..NCLASS {
+                s.young_alloc_class[k][c] += sc.young_alloc[c];
+                s.young_surv_class[k][c] += sc.young_surv[c];
+                s.young_alloc_bytes_class[k][c] += sc.young_alloc_bytes[c];
+                s.young_surv_bytes_class[k][c] += sc.young_surv_bytes[c];
+            }
+        }
+        for a in 0..8 {
+            s.age_hist[a] += sc.age[a];
+        }
+        let _ = ya;
+    }
+    if let Some(w) = s.gclog.as_mut() {
+        let sc = scan.unwrap_or_default();
+        let _ = write!(
+            w,
+            "{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}",
+            gc,
+            alloc_seq,
+            frames,
+            regs,
+            mark_us,
+            sweep_us,
+            scan_us,
+            sc.young_alloc.iter().sum::<u64>(),
+            sc.young_alloc_bytes.iter().sum::<u64>(),
+            sc.young_surv.iter().sum::<u64>(),
+            sc.young_surv_bytes.iter().sum::<u64>(),
+            sc.live[0],
+            sc.live[1],
+            sc.live[2],
+            sc.live[3],
+            sc.live_bytes,
+            sc.dead_old,
+            sc.dead_old_bytes,
+            sc.arena_len[0],
+            sc.arena_len[1],
+            sc.arena_len[2],
+            sc.arena_len[3]
+        );
+        for c in 0..NCLASS {
+            let _ = write!(w, ",{},{}", sc.young_alloc[c], sc.young_surv[c]);
+        }
+        for a in 0..8 {
+            let _ = write!(w, ",{}", sc.age[a]);
+        }
+        let _ = writeln!(w);
+    }
+    s.gc_count += 1;
+    s.sp_frames = 0;
+    s.sp_regs = 0;
+}
+
+extern "C" fn dump_at_exit() {
+    let s = st();
+    if let Some(w) = s.gclog.as_mut() {
+        let _ = w.flush();
+    }
+    let mut out = String::new();
+    use std::fmt::Write as _;
+    let w = &mut out;
+    let _ = writeln!(w, "mode {}", MODE.load(Relaxed));
+    let _ = writeln!(
+        w,
+        "heaps_total {} heaps_max_live {}",
+        HEAPS_TOTAL.load(Relaxed),
+        HEAPS_MAX.load(Relaxed)
+    );
+    let _ = writeln!(w, "collections {}", s.pause_count);
+    let _ = writeln!(
+        w,
+        "pause_total_us {} pause_max_us {}",
+        s.pause_total_us, s.pause_max_us
+    );
+    let _ = writeln!(w, "sp_total_us {} sp_max_us {}", s.sp_total_us, s.sp_max_us);
+    let _ = writeln!(w, "max_frames {} max_regs {}", s.max_frames, s.max_regs);
+    if MODE.load(Relaxed) == MODE_FULL {
+        s.ensure_sites();
+        for v in 0..NVIEWS {
+            s.rs_flush(v);
+        }
+        let _ = writeln!(w, "alloc_total {}", s.alloc_seq);
+        let _ = writeln!(w, "vm_instrs {}", s.vm_instrs);
+        let _ = writeln!(w, "alloc_by_arena {:?}", s.alloc_by_arena);
+        let _ = writeln!(w, "bytes_by_arena {:?}", s.bytes_by_arena);
+        let _ = writeln!(w, "vec_len {:?}", s.vec_len);
+        let _ = writeln!(w, "vec_len_bytes {:?}", s.vec_len_bytes);
+        let _ = writeln!(w, "str_len {:?}", s.str_len);
+        let _ = writeln!(w, "str_len_bytes {:?}", s.str_len_bytes);
+        let _ = writeln!(w, "obj_variant {:?}", s.obj_variant);
+        let _ = writeln!(w, "obj_variant_bytes {:?}", s.obj_variant_bytes);
+        let _ = writeln!(w, "closure_fv {:?}", s.closure_fv);
+        let _ = writeln!(w, "record_fields {:?}", s.record_fields);
+        let _ = writeln!(w, "values_len {:?}", s.values_len);
+        let _ = writeln!(w, "size_hist {:?}", s.size_hist);
+        let _ = writeln!(w, "size_hist_bytes {:?}", s.size_hist_bytes);
+        for k in 0..2 {
+            let _ = writeln!(w, "young_alloc_class{} {:?}", k, s.young_alloc_class[k]);
+            let _ = writeln!(w, "young_surv_class{} {:?}", k, s.young_surv_class[k]);
+            let _ = writeln!(
+                w,
+                "young_alloc_bytes_class{} {:?}",
+                k, s.young_alloc_bytes_class[k]
+            );
+            let _ = writeln!(
+                w,
+                "young_surv_bytes_class{} {:?}",
+                k, s.young_surv_bytes_class[k]
+            );
+        }
+        let _ = writeln!(w, "age_hist {:?}", s.age_hist);
+        let _ = writeln!(w, "marked_total_sum {}", s.marked_total_sum);
+        for (i, ss) in s.sites.iter().enumerate() {
+            if ss.total == 0 {
+                continue;
+            }
+            let _ = writeln!(
+                w,
+                "site {} total {} imm {} heapval {} target_unknown {} young_target {:?} young_target_heapval {:?} young_value {:?} old_to_young {:?} old_target_heapval {:?}",
+                SITE_NAMES[i],
+                ss.total,
+                ss.imm,
+                ss.heapval,
+                ss.target_unknown,
+                ss.young_target,
+                ss.young_target_heapval,
+                ss.young_value,
+                ss.old_to_young,
+                ss.old_target_heapval
+            );
+        }
+        let _ = writeln!(
+            w,
+            "rs_sum {:?} rs_max {:?} rs_nonempty {:?}",
+            s.rs_sum, s.rs_max, s.rs_nonempty
+        );
+        let _ = writeln!(
+            w,
+            "idhash imm {} index {} rc {} equal_hash_calls {} equal_hash_fallback {}",
+            s.idhash_imm, s.idhash_index, s.idhash_rc, s.equal_hash_calls, s.equal_hash_fallback
+        );
+        let _ = writeln!(
+            w,
+            "cap_full {} frames {} regs {} max_regs {} restore {} rframes {} rregs {} cap_delim {} dframes {} dregs {}",
+            s.cap_full,
+            s.cap_full_frames,
+            s.cap_full_regs,
+            s.cap_full_max_regs,
+            s.restore_full,
+            s.restore_frames,
+            s.restore_regs,
+            s.cap_delim,
+            s.cap_delim_frames,
+            s.cap_delim_regs
+        );
+    }
+    match std::env::var("PATINA_DEMOG_OUT") {
+        Ok(p) => {
+            let _ = std::fs::write(p, out);
+        }
+        Err(_) => {
+            eprint!("{out}");
+        }
+    }
+}
