+//! Workload-demographics instrumentation. SCRATCH COPY ONLY — not part of
+//! Patina. Enabled by `PATINA_DEMOG`:
+//!   PATINA_DEMOG=full   allocation census, epochs, survival scan, store mix
+//!   PATINA_DEMOG=pause  per-collection pause timing only
+//! Outputs: PATINA_DEMOG_OUT (summary, key value lines; default stderr),
+//!          PATINA_DEMOG_GCLOG (one CSV row per collection),
+//!          PATINA_DEMOG_HEAPS (append "exe total max_live live_at_exit").
+//!
+//! The runtime is single-threaded; the global state below is touched only by
+//! the interpreter thread. Heap counting uses atomics (cargo test threads).
+
+use crate::tagged_value::TaggedValue;
+use std::cell::UnsafeCell;
+use std::io::Write;
+use std::sync::atomic::{AtomicU8, AtomicU32, AtomicUsize, Ordering::Relaxed};
+
+pub const MODE_OFF: u8 = 1;
+pub const MODE_FULL: u8 = 2;
+pub const MODE_PAUSE: u8 = 3;
+static MODE: AtomicU8 = AtomicU8::new(0);
+
+static HEAPS_TOTAL: AtomicUsize = AtomicUsize::new(0);
+static HEAPS_LIVE: AtomicUsize = AtomicUsize::new(0);
+static HEAPS_MAX: AtomicUsize = AtomicUsize::new(0);
+static PRIMARY: AtomicU32 = AtomicU32::new(u32::MAX);
+static HEAPS_ATEXIT: AtomicU8 = AtomicU8::new(0);
+
+unsafe extern "C" {
+    fn atexit(cb: extern "C" fn()) -> i32;
+}
+
+#[cold]
+fn init_mode() -> u8 {
+    let m = match std::env::var("PATINA_DEMOG").as_deref() {
+        Ok("full") | Ok("1") => MODE_FULL,
+        Ok("pause") => MODE_PAUSE,
+        _ => MODE_OFF,
+    };
+    MODE.store(m, Relaxed);
+    if m != MODE_OFF {
+        unsafe {
+            *G.0.get() = Some(Box::new(State::default()));
+            atexit(dump_at_exit);
+        }
+    }
+    m
+}
+
+#[inline(always)]
+pub fn mode() -> u8 {
+    let m = MODE.load(Relaxed);
+    if m != 0 { m } else { init_mode() }
+}
+
+#[inline(always)]
+pub fn full() -> bool {
+    mode() == MODE_FULL
+}
+
+struct Gs(UnsafeCell<Option<Box<State>>>);
+unsafe impl Sync for Gs {}
+static G: Gs = Gs(UnsafeCell::new(None));
+
+#[inline(always)]
+#[allow(clippy::mut_from_ref)]
+fn st() -> &'static mut State {
+    unsafe { (*G.0.get()).as_mut().unwrap_unchecked() }
+}
+
+// ---------------------------------------------------------------------------
+// Heap counting
+// ---------------------------------------------------------------------------
+
+#[derive(Debug)]
+pub struct HeapGuard {
+    pub id: u32,
+}
+
+extern "C" fn heaps_at_exit() {
+    if let Ok(path) = std::env::var("PATINA_DEMOG_HEAPS")
+        && let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path)
+    {
+        let exe = std::env::current_exe()
+            .ok()
+            .and_then(|p| p.file_name().map(|s| s.to_string_lossy().into_owned()))
+            .unwrap_or_default();
+        let _ = writeln!(
+            f,
+            "{} total={} max_live={} live_at_exit={}",
+            exe,
+            HEAPS_TOTAL.load(Relaxed),
+            HEAPS_MAX.load(Relaxed),
+            HEAPS_LIVE.load(Relaxed)
+        );
+    }
+}
+
+impl HeapGuard {
+    pub fn new() -> Self {
+        let id = HEAPS_TOTAL.fetch_add(1, Relaxed) as u32;
+        let live = HEAPS_LIVE.fetch_add(1, Relaxed) + 1;
+        HEAPS_MAX.fetch_max(live, Relaxed);
+        if std::env::var_os("PATINA_DEMOG_HEAPS").is_some()
+            && HEAPS_ATEXIT.swap(1, Relaxed) == 0
+        {
+            unsafe {
+                atexit(heaps_at_exit);
+            }
+        }
+        if mode() != MODE_OFF {
+            let _ = PRIMARY.compare_exchange(u32::MAX, id, Relaxed, Relaxed);
+        }
+        HeapGuard { id }
+    }
+    pub fn is_primary(&self) -> bool {
+        mode() != MODE_OFF && PRIMARY.load(Relaxed) == self.id
+    }
+}
+
+impl Default for HeapGuard {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Drop for HeapGuard {
+    fn drop(&mut self) {
+        HEAPS_LIVE.fetch_sub(1, Relaxed);
+    }
+}
