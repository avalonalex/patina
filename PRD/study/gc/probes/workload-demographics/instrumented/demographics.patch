+    s.pause_count += 1;
+    s.pause_total_us += pause;
+    s.pause_max_us = s.pause_max_us.max(pause);
+    if !s.gclog_init {
+        s.gclog_init = true;
+        if let Ok(p) = std::env::var("PATINA_DEMOG_GCLOG")
