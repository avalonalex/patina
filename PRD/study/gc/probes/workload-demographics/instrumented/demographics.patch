+/// Record one store. `target` is `None` for a store into an off-heap
+/// environment slot.
+#[inline]
+pub fn store(site: usize, target: Option<TaggedValue>, value: TaggedValue) {
+    if mode() != MODE_FULL {
+        return;
+    }
+    let s = st();
+    if site == S_ENV_DEFINE && s.skip_env_define {
+        s.skip_env_define = false;
+        return;
+    }
+    s.ensure_sites();
+    let tinfo = target.and_then(|t| s.slot_epoch(t));
+    let vinfo = if value.is_heap_pointer() { s.slot_epoch(value) } else { None };
+    let heapval = value.is_heap_pointer();
+    let mut ty = [false; NVIEWS];
+    let mut vy = [false; NVIEWS];
+    for v in 0..NVIEWS {
+        ty[v] = tinfo.is_some_and(|(sq, g, _)| s.young_in_view(v, sq, g));
+        vy[v] = vinfo.is_some_and(|(sq, g, _)| s.young_in_view(v, sq, g));
+    }
+    let mut o2y = [false; NVIEWS];
+    {
+        let ss = &mut s.sites[site];
+        ss.total += 1;
+        if target.is_none() || tinfo.is_none() {
+            ss.target_unknown += 1;
+        }
+        for v in 0..NVIEWS {
+            if ty[v] {
+                ss.young_target[v] += 1;
+            }
+        }
+        if !heapval {
+            ss.imm += 1;
+            return;
+        }
+        ss.heapval += 1;
+        for v in 0..NVIEWS {
+            if ty[v] {
+                ss.young_target_heapval[v] += 1;
+            } else {
+                ss.old_target_heapval[v] += 1;
+            }
+            if vy[v] {
+                ss.young_value[v] += 1;
+            }
+            if !ty[v] && vy[v] {
+                ss.old_to_young[v] += 1;
+                o2y[v] = true;
+            }
+        }
+    }
+    if let Some((_, _, key)) = tinfo {
+        for v in 0..NVIEWS {
+            if o2y[v] {
+                let e = s.view_epoch(v);
+                if e != s.rs_epoch[v] {
+                    s.rs_flush(v);
+                    s.rs_epoch[v] = e;
+                }
+                s.rs_set[v].insert(key);
+            }
+        }
+    }
+}
+
+/// Make the next `env_define` store not count (a caller recorded it under
+/// its own site).
+pub fn skip_next_env_define() {
+    if mode() == MODE_FULL {
+        st().skip_env_define = true;
+    }
+}
+
+#[inline(always)]
+pub fn vm_instr() {
+    if MODE.load(Relaxed) == MODE_FULL {
+        st().vm_instrs += 1;
+    }
+}
+
+pub fn identity_hash(kind: u8) {
+    if mode() == MODE_FULL {
+        let s = st();
+        match kind {
+            0 => s.idhash_imm += 1,
+            1 => s.idhash_index += 1,
+            _ => s.idhash_rc += 1,
+        }
+    }
+}
+
+pub fn equal_hash_call() {
+    if mode() == MODE_FULL {
+        st().equal_hash_calls += 1;
+    }
+}
+
+pub fn equal_hash_fallback() {
+    if mode() == MODE_FULL {
+        st().equal_hash_fallback += 1;
+    }
+}
+
+pub fn capture_full(frames: usize, regs: usize) {
+    if mode() == MODE_FULL {
+        let s = st();
+        s.cap_full += 1;
+        s.cap_full_frames += frames as u64;
+        s.cap_full_regs += regs as u64;
+        s.cap_full_max_regs = s.cap_full_max_regs.max(regs as u64);
+    }
+}
+
+pub fn restore_full(frames: usize, regs: usize) {
+    if mode() == MODE_FULL {
+        let s = st();
+        s.restore_full += 1;
+        s.restore_frames += frames as u64;
+        s.restore_regs += regs as u64;
+    }
+}
+
+pub fn capture_delim(frames: usize, regs: usize) {
+    if mode() == MODE_FULL {
+        let s = st();
+        s.cap_delim += 1;
+        s.cap_delim_frames += frames as u64;
+        s.cap_delim_regs += regs as u64;
+    }
+}
+
+/// VM safe point: stack shape just before a collection.
+pub fn safepoint_stack(frames: usize, regs: usize) {
+    if mode() != MODE_OFF {
+        let s = st();
+        s.sp_frames = frames as u64;
+        s.sp_regs = regs as u64;
+        s.max_frames = s.max_frames.max(frames as u64);
+        s.max_regs = s.max_regs.max(regs as u64);
+    }
+}
+
+/// VM safe point total (retire + collect), microseconds.
+pub fn safepoint_time(us: u64) {
+    if mode() != MODE_OFF {
+        let s = st();
+        s.sp_total_us += us;
+        s.sp_max_us = s.sp_max_us.max(us);
+    }
+}
