+            let mut w = std::io::BufWriter::new(f);
+            let _ = write!(
+                w,
+                "gc,alloc_seq,frames,regs,mark_us,sweep_us,scan_us,young_alloc,young_alloc_bytes,young_surv,young_surv_bytes,live_pairs,live_vectors,live_strings,live_objects,live_bytes,dead_old,dead_old_bytes,arena_pairs,arena_vectors,arena_strings,arena_objects"
