+// ---------------------------------------------------------------------------
+// Kinds and buckets
+// ---------------------------------------------------------------------------
+
+pub const ARENA_PAIR: usize = 0;
+pub const ARENA_VECTOR: usize = 1;
+pub const ARENA_STRING: usize = 2;
+pub const ARENA_OBJECT: usize = 3;
+
+pub const NVARIANT: usize = 28;
+pub const VARIANT_NAMES: [&str; NVARIANT] = [
+    "BigInt", "Rational", "Real", "Complex", "Symbol", "Bytevector", "Exception", "Procedure",
+    "Port", "Macro", "RecordType", "Record", "Identifier", "Continuation", "Parameter", "Promise",
+    "Library", "Values", "EnvironmentSpecifier", "PromptTag", "LabelPlaceholder", "MutableCell",
+    "Ephemeron", "VmClosure", "VmContinuationRef", "VmDelimitedContinuationRef", "CoreSyntax",
+    "Free",
+];
+pub const V_REAL: usize = 2;
+pub const V_RECORD: usize = 11;
+pub const V_IDENT: usize = 12;
+pub const V_VALUES: usize = 17;
+pub const V_CELL: usize = 21;
+pub const V_CLOSURE: usize = 23;
+
+/// Survival classes.
+pub const NCLASS: usize = 9;
+pub const CLASS_NAMES: [&str; NCLASS] = [
+    "pair", "vector", "string", "flonum", "closure", "cell", "identifier", "record", "other",
+];
+pub fn class_of(arena: usize, variant: usize) -> usize {
+    match arena {
+        ARENA_PAIR => 0,
+        ARENA_VECTOR => 1,
+        ARENA_STRING => 2,
+        _ => match variant {
+            V_REAL => 3,
+            V_CLOSURE => 4,
+            V_CELL => 5,
+            V_IDENT => 6,
+            V_RECORD => 7,
+            _ => 8,
+        },
+    }
+}
+
+/// Length buckets: 0,1,2,3,4,5-8,9-16,17-32,33-64,65-128,129-256,257-1024,1025-8192,>8192
+pub const NLEN: usize = 14;
+pub const LEN_NAMES: [&str; NLEN] = [
+    "0", "1", "2", "3", "4", "5-8", "9-16", "17-32", "33-64", "65-128", "129-256", "257-1024",
+    "1025-8192", ">8192",
+];
+pub fn len_bucket(n: usize) -> usize {
+    match n {
+        0..=4 => n,
+        5..=8 => 5,
+        9..=16 => 6,
+        17..=32 => 7,
+        33..=64 => 8,
+        65..=128 => 9,
+        129..=256 => 10,
+        257..=1024 => 11,
+        1025..=8192 => 12,
+        _ => 13,
+    }
+}
+
+/// Size buckets (hypothetical bytes, upper bounds).
+pub const NSIZE: usize = 16;
+pub const SIZE_BOUNDS: [u64; NSIZE] = [
+    16, 24, 32, 48, 64, 96, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, u64::MAX,
+];
+pub fn size_bucket(b: u64) -> usize {
+    SIZE_BOUNDS.iter().position(|&ub| b <= ub).unwrap_or(NSIZE - 1)
+}
+
+pub fn round8(n: u64) -> u64 {
+    (n + 7) & !7
+}
+pub fn vector_bytes(len: usize) -> u64 {
+    8 + 8 * len as u64
+}
+pub fn string_bytes(len: usize) -> u64 {
+    8 + round8(4 * len as u64)
+}
+
+// ---------------------------------------------------------------------------
+// Stores
+// ---------------------------------------------------------------------------
+
+pub const NSITES: usize = 17;
+pub const SITE_NAMES: [&str; NSITES] = [
+    "set_car", "set_cdr", "vector_set", "vm_vector_set", "write_mutable_cell",
+    "set_vm_closure_free_var", "promise_update", "break_ephemeron", "record_set",
+    "parameter_install", "parameter_install_converted", "promise_force_prim",
+    "promise_force_vm", "env_define", "env_set_slot_value", "env_set_scoped", "tw_cont_define",
+];
+pub const S_SET_CAR: usize = 0;
+pub const S_SET_CDR: usize = 1;
+pub const S_VECTOR_SET: usize = 2;
+pub const S_VM_VECTOR_SET: usize = 3;
+pub const S_CELL: usize = 4;
+pub const S_CLOSURE_FV: usize = 5;
+pub const S_PROMISE_UPDATE: usize = 6;
+pub const S_BREAK_EPH: usize = 7;
+pub const S_RECORD_SET: usize = 8;
+pub const S_PARAM: usize = 9;
+pub const S_PARAM2: usize = 10;
+pub const S_PROMISE_PRIM: usize = 11;
+pub const S_PROMISE_VM: usize = 12;
+pub const S_ENV_DEFINE: usize = 13;
+pub const S_ENV_SET_SLOT: usize = 14;
+pub const S_ENV_SET_SCOPED: usize = 15;
+pub const S_TW_CONT_DEFINE: usize = 16;
+
+/// View 0 = "since the last actual collection"; views 1..=5 = a nursery
+/// emptied every N allocations.
+pub const NVIEWS: usize = 6;
+pub const NURSERY: [u64; 5] = [16_384, 65_536, 262_144, 1_048_576, 4_194_304];
+pub const VIEW_NAMES: [&str; NVIEWS] = ["actual", "16K", "64K", "256K", "1M", "4M"];
+
+#[derive(Default, Clone)]
+struct SiteStat {
+    total: u64,
+    imm: u64,
+    heapval: u64,
+    target_unknown: u64,
+    young_target: [u64; NVIEWS],
+    young_target_heapval: [u64; NVIEWS],
+    young_value: [u64; NVIEWS],
+    old_to_young: [u64; NVIEWS],
+    old_target_heapval: [u64; NVIEWS],
+}
+
+const FREE: u32 = u32::MAX;
+
+#[derive(Default)]
+struct State {
+    // allocation census
+    alloc_seq: u64,
+    alloc_by_arena: [u64; 4],
+    bytes_by_arena: [u64; 4],
+    vec_len: [u64; NLEN],
+    vec_len_bytes: [u64; NLEN],
+    str_len: [u64; NLEN],
+    str_len_bytes: [u64; NLEN],
+    obj_variant: [u64; NVARIANT],
+    obj_variant_bytes: [u64; NVARIANT],
+    closure_fv: [u64; NLEN],
+    record_fields: [u64; NLEN],
+    values_len: [u64; NLEN],
+    size_hist: [u64; NSIZE],
+    size_hist_bytes: [u64; NSIZE],
+    // per-slot epochs: allocation sequence number and collection number
+    seq: [Vec<u64>; 4],
+    gcno: [Vec<u32>; 4],
+    gc_count: u32,
+    // survival aggregates (all collections; and excluding the first)
+    young_alloc_class: [[u64; NCLASS]; 2],
+    young_surv_class: [[u64; NCLASS]; 2],
+    young_alloc_bytes_class: [[u64; NCLASS]; 2],
+    young_surv_bytes_class: [[u64; NCLASS]; 2],
+    age_hist: [u64; 8],
+    // stores
+    sites: Vec<SiteStat>,
+    rs_set: Vec<rustc_hash::FxHashSet<u64>>,
+    rs_epoch: [u64; NVIEWS],
+    rs_sum: [u64; NVIEWS],
+    rs_max: [u64; NVIEWS],
+    rs_nonempty: [u64; NVIEWS],
+    vm_instrs: u64,
+    skip_env_define: bool,
+    // hashing
+    idhash_imm: u64,
+    idhash_index: u64,
+    idhash_rc: u64,
+    equal_hash_calls: u64,
+    equal_hash_fallback: u64,
+    // continuations
+    cap_full: u64,
+    cap_full_frames: u64,
+    cap_full_regs: u64,
+    cap_full_max_regs: u64,
+    restore_full: u64,
+    restore_frames: u64,
+    restore_regs: u64,
+    cap_delim: u64,
+    cap_delim_frames: u64,
+    cap_delim_regs: u64,
+    // per-collection
+    sp_frames: u64,
+    sp_regs: u64,
+    max_frames: u64,
+    max_regs: u64,
+    pause_count: u64,
+    pause_total_us: u64,
+    pause_max_us: u64,
+    sp_total_us: u64,
+    sp_max_us: u64,
+    gclog: Option<std::io::BufWriter<std::fs::File>>,
+    gclog_init: bool,
+    marked_total_sum: u64,
+}
+
+impl State {
+    fn ensure_sites(&mut self) {
+        if self.sites.is_empty() {
+            self.sites = vec![SiteStat::default(); NSITES];
+            self.rs_set = (0..NVIEWS).map(|_| Default::default()).collect();
+        }
+    }
+
+    #[inline]
+    fn slot_epoch(&self, tv: TaggedValue) -> Option<(u64, u32, u64)> {
+        let arena = if tv.is_pair() {
+            ARENA_PAIR
+        } else if tv.is_vector() {
+            ARENA_VECTOR
+        } else if tv.is_string() {
+            ARENA_STRING
+        } else if tv.is_object() {
+            ARENA_OBJECT
+        } else {
+            return None;
+        };
+        let idx = tv.heap_index() as usize;
+        let seq = *self.seq[arena].get(idx)?;
+        let g = self.gcno[arena][idx];
+        Some((seq, g, ((arena as u64) << 32) | idx as u64))
+    }
+
+    #[inline]
+    fn young_in_view(&self, v: usize, seq: u64, g: u32) -> bool {
+        if v == 0 {
+            g == self.gc_count
+        } else {
+            let n = NURSERY[v - 1];
+            let now = self.alloc_seq;
+            seq >= now - (now % n)
+        }
+    }
+
+    fn view_epoch(&self, v: usize) -> u64 {
+        if v == 0 {
+            self.gc_count as u64
+        } else {
+            self.alloc_seq / NURSERY[v - 1]
+        }
+    }
+
+    fn rs_flush(&mut self, v: usize) {
+        let n = self.rs_set[v].len() as u64;
+        self.rs_sum[v] += n;
+        self.rs_max[v] = self.rs_max[v].max(n);
+        if n > 0 {
+            self.rs_nonempty[v] += 1;
+        }
+        self.rs_set[v].clear();
+    }
+}
+
+#[inline]
+pub fn on_alloc(arena: usize, idx: u32, variant: usize, len: usize, bytes: u64) {
+    let s = st();
+    let i = idx as usize;
+    if s.seq[arena].len() <= i {
+        s.seq[arena].resize(i + 1, 0);
+        s.gcno[arena].resize(i + 1, FREE);
+    }
+    s.seq[arena][i] = s.alloc_seq;
+    s.gcno[arena][i] = s.gc_count;
+    s.alloc_seq += 1;
+    s.alloc_by_arena[arena] += 1;
+    s.bytes_by_arena[arena] += bytes;
+    let sb = size_bucket(bytes);
+    s.size_hist[sb] += 1;
+    s.size_hist_bytes[sb] += bytes;
+    match arena {
+        ARENA_VECTOR => {
+            s.vec_len[len_bucket(len)] += 1;
+            s.vec_len_bytes[len_bucket(len)] += bytes;
+        }
+        ARENA_STRING => {
+            s.str_len[len_bucket(len)] += 1;
+            s.str_len_bytes[len_bucket(len)] += bytes;
+        }
+        ARENA_OBJECT => {
+            s.obj_variant[variant] += 1;
+            s.obj_variant_bytes[variant] += bytes;
+            match variant {
+                V_CLOSURE => s.closure_fv[len_bucket(len)] += 1,
+                V_RECORD => s.record_fields[len_bucket(len)] += 1,
+                V_VALUES => s.values_len[len_bucket(len)] += 1,
+                _ => {}
+            }
+        }
+        _ => {}
+    }
+}
